{
  "name": "hthv4-browser",
  "productName": "HTHV4 Browser",
  "version": "1.2.0",
  "description": "Trinh duyet Electron mo san trang HTHV4, URL co the cau hinh qua man hinh Settings",
  "main": "src/main.js",
  "author": "trong",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish=never",
    "dist:win": "electron-builder --win --publish=never",
    "dist:win:publish": "electron-builder --win --publish=always",
    "dist:linux": "electron-builder --linux --publish=never",
    "dist:mac": "electron-builder --mac --publish=never"
  },
  "build": {
    "appId": "vn.vnpthis.hthv4browser",
    "productName": "HTHV4 Browser",
    "publish": [
      {
        "provider": "github",
        "owner": "trongdqtgg",
        "repo": "trinhduyet_release"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Network"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  }
}
